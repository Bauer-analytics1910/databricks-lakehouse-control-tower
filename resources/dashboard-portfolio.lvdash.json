{
  "datasets": [
    {
      "name": "ds_portfolio",
      "displayName": "Situação dos Projetos",
      "queryLines": [
        "SELECT\n",
        "  projeto_id,\n",
        "  projeto,\n",
        "  nome_projeto,\n",
        "  cliente,\n",
        "  segmento,\n",
        "  tipo_projeto,\n",
        "  ferramenta,\n",
        "  gerente_projeto,\n",
        "  valor_contrato,\n",
        "  orcamento,\n",
        "  data_inicio,\n",
        "  data_fim_baseline,\n",
        "  duracao_baseline_dias,\n",
        "  status,\n",
        "  pv,\n",
        "  ev,\n",
        "  ac,\n",
        "  spi,\n",
        "  cpi,\n",
        "  eac,\n",
        "  estouro_previsto,\n",
        "  margem_projetada,\n",
        "  atraso_projetado_dias,\n",
        "  situacao,\n",
        "  farol_do_gerente,\n",
        "  farol_calculado,\n",
        "  melancia,\n",
        "  CASE WHEN melancia THEN 1 ELSE 0 END AS melancia_flag,\n",
        "  CASE WHEN status = 'em_andamento' THEN 1 ELSE 0 END AS em_andamento_flag\n",
        "FROM projeto_situacao_atual\n"
      ]
    },
    {
      "name": "ds_ml_score",
      "displayName": "Risco de Estouro (ML)",
      "queryLines": [
        "SELECT\n",
        "  s.projeto_id,\n",
        "  p.nome_projeto,\n",
        "  p.cliente,\n",
        "  p.segmento,\n",
        "  p.gerente_projeto,\n",
        "  s.data_referencia,\n",
        "  s.prob_estouro_30d,\n",
        "  s.ranking,\n",
        "  s.faixa_risco,\n",
        "  s.principais_fatores,\n",
        "  p.spi,\n",
        "  p.cpi,\n",
        "  p.estouro_previsto\n",
        "FROM score_estouro_30d s\n",
        "JOIN projeto_situacao_atual p USING (projeto_id)\n",
        "ORDER BY s.ranking ASC\n"
      ]
    },
    {
      "name": "ds_pessoas",
      "displayName": "Utilização e Pessoas",
      "queryLines": [
        "SELECT\n",
        "  colaborador_id,\n",
        "  nome,\n",
        "  papel,\n",
        "  senioridade,\n",
        "  projeto_id,\n",
        "  semana,\n",
        "  horas_disponiveis,\n",
        "  horas_apontadas,\n",
        "  horas_ociosas,\n",
        "  utilizacao,\n",
        "  custo_ocioso,\n",
        "  spi_do_projeto\n",
        "FROM utilizacao_pessoa_semana\n"
      ]
    },
    {
      "name": "ds_status_ia",
      "displayName": "Status Estruturado por IA",
      "queryLines": [
        "SELECT\n",
        "  projeto_id,\n",
        "  data_status,\n",
        "  farol,\n",
        "  causa_bloqueio,\n",
        "  bloqueio,\n",
        "  quem_destrava,\n",
        "  dias_impacto,\n",
        "  metodo,\n",
        "  texto_status\n",
        "FROM status_estruturado\n"
      ]
    },
    {
      "name": "ds_fornecedores",
      "displayName": "Entregas de Fornecedores",
      "queryLines": [
        "SELECT\n",
        "  entrega_id,\n",
        "  projeto_id,\n",
        "  fornecedor,\n",
        "  item,\n",
        "  valor,\n",
        "  data_pedido,\n",
        "  data_prometida,\n",
        "  data_entrega,\n",
        "  prazo_contratado_dias,\n",
        "  prazo_prometido_dias,\n",
        "  prazo_real_dias,\n",
        "  dias_de_atraso_na_entrega,\n",
        "  em_aberto,\n",
        "  em_atraso,\n",
        "  CASE WHEN em_atraso THEN 1 ELSE 0 END AS em_atraso_flag,\n",
        "  status\n",
        "FROM lakehouse_vertice.silver.entregas_fornecedor\n"
      ]
    }
  ],
